  <!-- ── PAGE 2: FAMILY ── -->
  <div id="page-family" class="section" style="padding:70px 20px 100px;">
    <div class="family-card">
      <div class="ph" style="color:var(--maroon-d);">✦ With the Blessings of Lord Ganesha ✦</div>
