/* ═══════════ GUEST WISHES WALL — backed by GitHub Issues ═══════════
   HOW THIS WORKS:
   - Every wish is created as an Issue in the repo below via the GitHub REST API.
   - Reading the wall (GET /issues) needs no token — public repo issues are
     public. Anyone with this link can see the wall live.
   - Posting a NEW wish (POST /issues) needs the token below, because GitHub
     requires auth to create issues even on public repos.

   ⚠️ SECURITY — NO TOKEN LIVES HERE ANYMORE:
   Writing a wish (creating an Issue) now goes through a Cloudflare Worker,
   which holds the GitHub token server-side as an encrypted secret. This
   file only knows the Worker's public URL — nothing secret is exposed by
   viewing source. See worker.js for the proxy code and setup notes.
*/
const GH_OWNER = 'atharva72283';   // ← replace, used only for the public GET (reading wishes)
const GH_REPO  = 'Invitation';   // ← replace if you named it differently
const WORKER_URL = 'https://wall-of-blessing.atharva72283.workers.dev/'; // ← replace after deploying worker.js

const WISH_SEED = [
  {n:'Savita', m:'May your bond grow stronger with every passing year 💕'},
  {n:'Mohan', m:'So so happy for you both! Can’t wait to dance at the sangeet 🎉'},
  {n:'Atharva', m:'Wishing you a lifetime of love and laughter ✨'}
];
const GH_READY = GH_OWNER !== 'YOUR_GITHUB_USERNAME';
const WRITE_READY = WORKER_URL !== 'https://PASTE_YOUR_WORKER_URL_HERE.workers.dev';

async function loadWishes(){
  if(!GH_READY) return WISH_SEED; // config not filled in yet — show placeholders instead of failing silently
  try{
    const res = await fetch(`https://api.github.com/repos/${GH_OWNER}/${GH_REPO}/issues?state=open&per_page=100&sort=created&direction=desc`,{
      headers:{ 'Accept':'application/vnd.github+json' }
    });
    if(!res.ok) throw new Error('GitHub read failed: '+res.status);
    const issues = await res.json();
    return issues
      .filter(i=>!i.pull_request && i.title && i.title.includes('::'))
      .map(i=>{
        const [n,...rest] = i.title.split('::');
        return {n:n.trim(), m:rest.join('::').trim() || i.body || ''};
      });
  }catch(e){
    console.error('Wishes load failed, showing local fallback:', e);
    return WISH_SEED;
  }
}
async function renderWishes(){
  const wishes = await loadWishes();
  const track = document.getElementById('wishesTrack');
  if(!track) return;
  track.innerHTML = wishes.map(w=>`
    <div class="paper-note">
      <div class="pn-msg">"${escapeHtml(w.m)}"</div>
      <div class="pn-name">— ${escapeHtml(w.n)}</div>
    </div>`).join('');
}
function escapeHtml(s){
  const d = document.createElement('div'); d.textContent = s; return d.innerHTML;
}
// Optimistic UI: stick the note onto the wall instantly, before the network
// call to the Worker/GitHub even resolves. Returns the element so addWish()
// can remove it again if the save turns out to have failed.
function pinNoteToWall(name, message){
  const track = document.getElementById('wishesTrack');
  if(!track) return null;
  const el = document.createElement('div');
  el.className = 'paper-note just-pinned';
  el.innerHTML = `
      <div class="pn-msg">"${escapeHtml(message)}"</div>
      <div class="pn-name">— ${escapeHtml(name)}</div>`;
  track.prepend(el);
  el.scrollIntoView({behavior:'smooth', block:'nearest'});
  return el;
}
async function addWish(){
  const nameEl = document.getElementById('wishName');
  const msgEl = document.getElementById('wishMsg');
  const btn = document.querySelector('.wish-send-btn');
  const n = nameEl.value.trim(), m = msgEl.value.trim();
  if(!n || !m){ alert('Please add your name and a short blessing 🙏'); return; }
  if(!WRITE_READY){ alert('The Wall of Blessings isn\'t connected yet — the couple needs to finish setup.'); return; }
  btn.disabled = true; btn.textContent = 'Pinning...';

  // Pin it to the wall right away — don't make the guest wait on GitHub's API.
  const noteEl = pinNoteToWall(n, m);
  nameEl.value=''; msgEl.value='';
  confetti();

  try{
    const res = await fetch(WORKER_URL,{
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({ name:n, message:m })
    });
    if(!res.ok) throw new Error('Worker write failed: '+res.status);
    // Success — the optimistic note stays exactly where it is. A fresh
    // GitHub-backed copy will appear naturally next time someone loads the page.
  }catch(e){
    console.error(e);
    // The save actually failed, so remove the note we jumped the gun on.
    if(noteEl) noteEl.remove();
    alert('Hmm, that didn\'t save — your note has been removed from the wall. Please try again in a moment.');
  }finally{
    btn.disabled = false; btn.textContent = 'Pin It To The Wall ✦';
  }
}

