<script>
/* ═══════════ SEAL ═══════════ */
function breakSeal(){
  const wrap = document.getElementById('sealWrap');
  const hint = document.getElementById('sealHint');
  wrap.classList.add('breaking');
  hint.textContent = '✨ Opening...';
  hint.style.animation = 'none';
  confetti(); // burst the instant the seal cracks, not after the screen fades

  // Wax shards burst
  const screen = document.getElementById('sealScreen');
  const colors = ['#a03020','#c04030','#7a2010','#d05040','#e06050'];
  for(let i=0;i<22;i++){
    const s = document.createElement('div');
    s.className = 'shard';
    const ang = (i/22)*360, rad = 80+Math.random()*60;
    const cx = 50, cy = 50;
    const ex = cx + Math.cos(ang*Math.PI/180)*rad;
    const ey = cy + Math.sin(ang*Math.PI/180)*rad;
    s.style.cssText = `
      left:${cx}%;top:${cy}%;
      background:${colors[Math.floor(Math.random()*colors.length)]};
      width:${10+Math.random()*18}px;height:${8+Math.random()*14}px;
      opacity:1;
      transition:all ${0.4+Math.random()*0.3}s ease-out;
      transform:translate(-50%,-50%) rotate(${Math.random()*360}deg);
    `;
    screen.appendChild(s);
    requestAnimationFrame(()=>{
      setTimeout(()=>{
        s.style.left = ex+'%';
        s.style.top = ey+'%';
        s.style.opacity = '0';
        s.style.transform = `translate(-50%,-50%) rotate(${Math.random()*720}deg) scale(0.3)`;
      },20);
    });
    setTimeout(()=>s.remove(), 800);
  }

  setTimeout(()=>{
    // Fade out seal screen
    document.getElementById('sealScreen').style.transition = 'opacity 0.5s ease';
    document.getElementById('sealScreen').style.opacity = '0';
    setTimeout(()=>{
      document.getElementById('sealScreen').style.display = 'none';
      document.getElementById('app').style.display = 'block';
      document.getElementById('bottomNav').style.display = 'flex';
      document.getElementById('musicToggle').style.display = 'flex';
      initPetals();
      initScratch();
      initCD();
      initScrollSpy();
      renderWishes();
      playMusic();
    }, 500);
  }, 600);
}

/* ═══════════ BACKGROUND MUSIC ═══════════
   Playback is kicked off from inside breakSeal(), which only ever runs as a
   direct result of the user's tap on the seal — that tap IS the "user
   gesture" browsers require before they'll allow audio with sound to play.
   Calling audio.play() from a setTimeout/promise chain that started inside
   that same click handler still counts, so this satisfies iOS Safari and
   Chrome's autoplay policies without needing a second tap. */
function playMusic(){
  const audio = document.getElementById('bgMusic');
  const btn = document.getElementById('musicToggle');
  audio.volume = 0.55;
  audio.play().then(()=>{
    btn.classList.remove('paused');
  }).catch(()=>{
    // Autoplay was blocked anyway (can happen on some Android WebViews) —
    // leave it paused and let the visible toggle button start it instead.
    btn.classList.add('paused');
  });
}
function toggleMusic(){
  const audio = document.getElementById('bgMusic');
  const btn = document.getElementById('musicToggle');
  if(audio.paused){
    audio.play().then(()=>btn.classList.remove('paused')).catch(()=>{});
  } else {
    audio.pause();
    btn.classList.add('paused');
  }
}

