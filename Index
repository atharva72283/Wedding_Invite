/* Highlights the bottom-nav item matching whichever section is in view while scrolling */
function initScrollSpy(){
  const sections = document.querySelectorAll('.section');
  const spy = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        document.querySelectorAll('.ni').forEach(n=>n.classList.remove('active'));
        const nav = document.getElementById(navMap[e.target.id]);
        if(nav) nav.classList.add('active');
      }
    });
  },{threshold:0.5});
  sections.forEach(s=>spy.observe(s));
}

/* ═══════════ SCRATCH CARD ═══════════ */
function initScratch(){
  const cv = document.getElementById('scratchCanvas');
  // Match canvas to its container width
  const container = cv.parentElement.parentElement;
  const w = container.offsetWidth - 2; // account for border
  cv.width = w > 0 ? w : 260;
  const ctx = cv.getContext('2d');
  let drawing = false, revealed = false;

  const g = ctx.createLinearGradient(0,0,cv.width,108);
  g.addColorStop(0,'#b8851e');g.addColorStop(.35,'#d4aa40');g.addColorStop(.65,'#c9973a');g.addColorStop(1,'#8b6520');
  ctx.fillStyle = g;
  if(ctx.roundRect) ctx.roundRect(0,0,cv.width,108,12);
  else ctx.rect(0,0,cv.width,108);
  ctx.fill();

  ctx.fillStyle='rgba(255,248,220,.85)';
  ctx.textAlign='center';
  const mx = cv.width/2;
  ctx.font='bold 15px "Cinzel",serif';ctx.fillText('✦  SCRATCH TO REVEAL  ✦',mx,40);
  ctx.font='13px "Lato",sans-serif';ctx.fillStyle='rgba(255,248,220,.65)';
  ctx.fillText('The wedding dates are hidden inside',mx,64);
  ctx.font='22px serif';ctx.fillText('🌸  💍  🌸',mx,90);
  ctx.globalCompositeOperation='destination-out';

  function getPos(e){
    const r=cv.getBoundingClientRect(),sx=cv.width/r.width,sy=cv.height/r.height;
    if(e.touches)return{x:(e.touches[0].clientX-r.left)*sx,y:(e.touches[0].clientY-r.top)*sy};
    return{x:(e.clientX-r.left)*sx,y:(e.clientY-r.top)*sy};
  }
  function draw(e){if(!drawing)return;e.preventDefault();const p=getPos(e);ctx.beginPath();ctx.arc(p.x,p.y,24,0,Math.PI*2);ctx.fill();check();}
  function check(){
    if(revealed)return;
    const d=ctx.getImageData(0,0,cv.width,108).data;let cl=0;
    for(let i=3;i<d.length;i+=4)if(d[i]===0)cl++;
    if(cl/(cv.width*108)>0.5){
      revealed=true;ctx.clearRect(0,0,cv.width,108);
      const h=document.getElementById('scratchHint');
      h.textContent='🎉 12 December 2026 — Save the date!';
      h.style.color='var(--gold-d)';h.style.animation='none';h.style.fontWeight='700';
      confetti();
    }
  }
  cv.addEventListener('mousedown',()=>drawing=true);
  cv.addEventListener('mousemove',draw);
  cv.addEventListener('mouseup',()=>drawing=false);
  cv.addEventListener('mouseleave',()=>drawing=false);
  cv.addEventListener('touchstart',()=>drawing=true,{passive:false});
  cv.addEventListener('touchmove',draw,{passive:false});
  cv.addEventListener('touchend',()=>drawing=false);
}

/* ═══════════ CONFETTI ═══════════ */
function confetti(){
  const cols=['#c9973a','#e8d5a3','#f0d060','#8b6520','#fff3c0','#c0a030','#e8b4c0','#b8d4a0'];
  for(let i=0;i<80;i++){
    const el=document.createElement('div');el.className='cfp';
